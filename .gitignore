# Miscellaneous
*.class
*.log
*.pyc
*.swp
*~
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Test coverage output (generated by flutter test --coverage)
coverage/

# FVM Version Cache
.fvm/report/

# Android signing — NEVER commit these
android/key.properties
*.jks
*.keystore

# Firebase config — contains API keys; injected at build time
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# env/ — every local operational credential (Flutter dart-define files,
# challenge_bot's Telegram token) lives here as one directory now. Glob
# (not exact match) covers real files regardless of name; *.example and
# README.md are the only things meant to be committed. Admin-tier secrets
# (service-role keys, DB passwords, R2, the release keystore) never land
# here at all — see ~/StudioProjects/pahlevani-admin-creds/ instead,
# sourced on demand by scripts/with_admin_creds.sh.
env/*
!env/*.example
!env/README.md

# DB migration test — real Supabase credentials (copy from supabase/.db.env.example)
supabase/.db.env

# Supabase snapshot — table data + media files downloaded by scripts/dump_supabase.py
supabase/dump/

# One-off prod DB snapshot (roles/schema dump) — never commit
supabase/db_snapshot/

# Challenge bot standalone deployment env (VPS/systemd — no vault access
# there, so this needs to be self-contained; see challenge_bot/DEPLOY.md).
# Local dev doesn't use this file at all — see env/challenge_bot.env instead.
challenge_bot/.env

# Python virtual environment and version pin (used by scripts/)
.venv/
.python-version

# Claude Code internal files (worktrees, session state)
.claude/
