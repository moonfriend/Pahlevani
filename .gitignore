# Miscellaneous
*.class
*.log
*.pyc
*.swp
*~
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Test coverage output (generated by flutter test --coverage)
coverage/

# FVM Version Cache
.fvm/report/

# Streamlit secrets
scripts/.streamlit/secrets.toml

# Android signing — NEVER commit these
android/key.properties
*.jks
*.keystore

# Firebase config — contains API keys; injected at build time
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Firebase local dev env (real keys for --dart-define-from-file)
.firebase.env

# Supabase staging env (real keys for --dart-define-from-file)
.supabase.env

# DB migration test — real Supabase credentials (copy from supabase/.db.env.example)
supabase/.db.env

# Supabase snapshot — table data + media files downloaded by scripts/dump_supabase.py
supabase/dump/

# One-off prod DB snapshot (roles/schema/data dump + low-priv .env) — never commit
supabase/db_snapshot/

# Challenge bot — real Telegram token + Supabase service-role key (copy from .env.example)
challenge_bot/.env

# Raw credential files (e.g. R2 API tokens) — never commit
creds/

# Python virtual environment and version pin (used by scripts/)
.venv/
.python-version

# Claude Code internal files (worktrees, session state)
.claude/
