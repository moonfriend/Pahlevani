# Supabase direct PostgreSQL connection — used by scripts/test_migration.sh
# to pull the live schema via pg_dump before running migration tests.
#
# Copy this file to supabase/.db.env and fill in your values.
# Find them in: Supabase Dashboard → Settings → Database → Connection string (Direct)
#
# The DB password is the one you set when creating the project (not the anon key).
# If you forgot it, reset it in: Settings → Database → Reset database password.

SUPABASE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
SUPABASE_DB_PASSWORD=your-database-password
