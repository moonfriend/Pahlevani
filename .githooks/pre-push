#!/usr/bin/env bash
# Blocks 'git push' if the branch contains new migration files that have not
# been validated by scripts/test_migration.sh.
#
# The test script creates supabase/.migration_test_ok on success.
# This hook checks that the sentinel is newer than every pending migration file.
#
# Bypass (emergency only): SKIP_MIGRATION_TEST=1 git push

set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
SENTINEL="${REPO_ROOT}/supabase/.migration_test_ok"

if [[ "${SKIP_MIGRATION_TEST:-}" == "1" ]]; then
  echo "⚠️  SKIP_MIGRATION_TEST=1 set — bypassing migration test gate."
  exit 0
fi

# Find migration files that exist here but not in origin/main.
PENDING=()
git fetch origin main --quiet 2>/dev/null || true
while IFS= read -r file; do
  [[ -n "$file" ]] && PENDING+=("${REPO_ROOT}/${file}")
done < <(git diff origin/main HEAD --name-only --diff-filter=A -- 'supabase/migrations/*.sql' 2>/dev/null || true)

if [[ ${#PENDING[@]} -eq 0 ]]; then
  exit 0  # nothing to gate
fi

# Check sentinel exists and is newer than all pending migration files.
for migration in "${PENDING[@]}"; do
  if [[ ! -f "${SENTINEL}" ]] || [[ "${migration}" -nt "${SENTINEL}" ]]; then
    echo ""
    echo "❌  Migration gate: $(basename "${migration}") has not been validated."
    echo ""
    echo "   Run:  bash scripts/test_migration.sh"
    echo "   Then re-push."
    echo ""
    echo "   Emergency bypass:  SKIP_MIGRATION_TEST=1 git push"
    exit 1
  fi
done

exit 0
